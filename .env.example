# Catalogo de imagenes
STAC_API_URL=https://earth-search.aws.element84.com/v1
# sentinel-2-l2a tiene cobertura continua 2015-2026.
# sentinel-2-c1-l2a esta mejor corregida pero le falta 2022 entero.
STAC_COLLECTION=sentinel-2-l2a
STAC_MAX_CLOUD_COVER=20

# Almacen de objetos. En local apunta a MinIO; para desplegar en AWS basta con
# dejar S3_ENDPOINT_URL vacio y poner credenciales reales.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lakehouse
S3_REGION=us-east-1

# Procesamiento
TARGET_RESOLUTION_M=100
MIN_VALID_PIXEL_FRACTION=0.30
MAX_WORKERS=4

# Precipitacion de AEMET, para contrastar la anomalia de NDVI con la lluvia
# que de verdad falto. La clave se pide gratis y llega por correo desde
# https://opendata.aemet.es/centrodedescargas/altaUsuario
# Es un token largo: va en .env, que no se versiona, nunca aqui.
AEMET_API_KEY=
AEMET_API_URL=https://opendata.aemet.es/opendata
