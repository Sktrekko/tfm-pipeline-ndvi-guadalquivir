# Catalogo de imagenes
STAC_API_URL=https://earth-search.aws.element84.com/v1
# sentinel-2-l2a tiene cobertura continua 2015-2026.
# sentinel-2-c1-l2a esta mejor corregida pero le falta 2022 entero.
STAC_COLLECTION=sentinel-2-l2a
STAC_MAX_CLOUD_COVER=20

# Almacen de objetos. En local apunta a MinIO; para desplegar en AWS basta con
# dejar S3_ENDPOINT_URL vacio y poner credenciales reales.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lakehouse
S3_REGION=us-east-1

# Procesamiento
TARGET_RESOLUTION_M=100
MIN_VALID_PIXEL_FRACTION=0.30
MAX_WORKERS=4
