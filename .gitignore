# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/          # entregable armado por scripts/build_deliverable.py

# Herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Datos y artefactos generados (no se versionan: se regeneran)
data/
*.duckdb
*.duckdb.wal
*.tif
*.parquet

# Artefactos de dbt. Las dependencias se restauran con `dbt deps` y el resto
# son ficheros de compilacion; lo que si se versiona es `package-lock.yml`,
# que fija las versiones exactas igual que hace `uv.lock` con Python.
dbt/dbt_packages/
dbt/target/
dbt/logs/
dbt/.user.yml

# Entorno
.env
.DS_Store

# Estado local de Airflow: base de datos de metadatos, logs y configuracion
# generada. Es equivalente a `data/`, se regenera con `airflow db migrate` y
# ademas incluye la clave de sesion, que no debe salir del equipo. Lo que si se
# versiona son los DAG, que viven en `dags/`.
airflow/
